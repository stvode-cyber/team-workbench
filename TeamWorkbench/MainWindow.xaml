<Window x:Class="TeamWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🤖 AI 专岗员工面板 v3.0 (Phase 1 · C# WPF)" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    <Grid>
        <!-- Phase 1 标题区 -->
        <Border Background="#16213e" Padding="20" Margin="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🤖 AI 专岗员工面板"
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="C# WPF · Phase 1 Hello World + SQLite"
                           FontSize="14" Foreground="#8892b0" Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DbStatus" Text=""
                           FontSize="12" Foreground="#64c8ff" Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
