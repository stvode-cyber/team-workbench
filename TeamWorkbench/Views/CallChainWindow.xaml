<Window x:Class="TeamWorkbench.Views.CallChainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vms="clr-namespace:TeamWorkbench.ViewModels"
        xmlns:views="clr-namespace:TeamWorkbench.Views"
        Title="🔗 调用链画布 · 拖拽连线"
        Height="600" Width="1100"
        MinHeight="420" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Style="{StaticResource MainWindowBg}">

    <!-- 合并资源字典（深色主题）-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 工具栏按钮样式（简洁深色）-->
            <Style x:Key="ToolBarBtn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：保存 / 重置 / 清空 / 状态 -->
        <Border Grid.Row="0" Background="{StaticResource BgMidBrush}" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 保存"   Style="{StaticResource ToolBarBtn}" Click="SaveBtn_Click"/>
                    <Button Content="↩️ 重置"   Style="{StaticResource ToolBarBtn}" Click="ResetBtn_Click"/>
                    <Button Content="🗑️ 清空"   Style="{StaticResource ToolBarBtn}" Click="ClearBtn_Click"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="红色圆点 = 从此拉出连线（此 Agent 依赖别人）｜ 蓝色圆点 = 目标（松开到这里）"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding Status}"
                           Foreground="{StaticResource AccentBlueBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Canvas 画布（核心）-->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Canvas x:Name="MainCanvas"
                    Background="{StaticResource BgDeepBrush}"
                    Width="1200" Height="800"
                    MouseMove="Canvas_MouseMove"
                    MouseUp="Canvas_MouseUp"
                    MouseLeave="Canvas_MouseUp">

                <!-- 连线层（ZIndex 0：先画边，再画节点盖上去）-->
                <Canvas x:Name="EdgesLayer"/>

                <!-- 临时预览连线（虚线 · 鼠标拉拽时显示）-->
                <Line x:Name="PreviewLine"
                      Stroke="{StaticResource AccentBrush}"
                      StrokeThickness="2"
                      StrokeDashArray="4,3"
                      Visibility="Collapsed"
                      Canvas.ZIndex="99"/>
            </Canvas>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource BgMidBrush}" Padding="12,0">
            <TextBlock x:Name="StatusBar"
                       Text="就绪"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
