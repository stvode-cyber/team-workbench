<Window x:Class="TeamWorkbench.Views.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛑 HITL 人类审批"
        Height="320" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Style="{StaticResource MainWindowBg}"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="24" Background="{StaticResource BgDeepBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部：大图标 + agent 名 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="🛑" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="AgentNameText"
                           Text="Agent 需要人类审批"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ApprovalIdText"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 中部：审批说明 -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgMidBrush}"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DescriptionText"
                               Text="该 Agent 标记了 approval_required=true。请检查任务内容并决定是否继续。"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- 底部：批准 / 拒绝 双按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RejectBtn"
                        Content="❌ 拒绝"
                        Height="38" Width="120"
                        Background="{StaticResource BgLightBrush}"
                        Foreground="{StaticResource StatusRedBrush}"
                        BorderThickness="0"
                        FontSize="14" FontWeight="Bold"
                        Cursor="Hand"
                        Click="RejectBtn_Click"/>
                <Button x:Name="ApproveBtn"
                        Content="✅ 批准"
                        Height="38" Width="140"
                        Margin="12,0,0,0"
                        Background="{StaticResource AccentBlueBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14" FontWeight="Bold"
                        Cursor="Hand"
                        Click="ApproveBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
