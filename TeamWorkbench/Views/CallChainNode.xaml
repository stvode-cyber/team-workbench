<UserControl x:Class="TeamWorkbench.Views.CallChainNode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:TeamWorkbench.ViewModels"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             Width="180" Height="60">

    <Grid>
        <!-- 卡片主体（圆角深色 + 鼠标过高亮）-->
        <Border x:Name="Card"
                Background="{StaticResource BgLightBrush}"
                CornerRadius="8"
                Padding="12,8"
                Cursor="Hand">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Emoji}"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CnName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Priority}"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 覆盖式 Thumb：整个卡片可拖拽 -->
        <Thumb x:Name="DragThumb"
               Background="Transparent"
               Cursor="SizeAll"/>

        <!-- 入口圆点（蓝色 · 左侧 · 连线松开命中目标）-->
        <Ellipse x:Name="EntryDot"
                 Tag="entry-dot"
                 Width="16" Height="16"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-4,0,0,0"
                 Fill="{StaticResource AccentBlueBrush}"
                 Stroke="{StaticResource BgDeepBrush}" StrokeThickness="2"
                 ToolTip="依赖此 Agent（松开连线到这里）"/>

        <!-- 出口圆点（红色 · 右侧 · MouseDown 启动连线）-->
        <Ellipse x:Name="ExitDot"
                 Tag="exit-dot"
                 Width="16" Height="16"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,-4,0"
                 Fill="{StaticResource AccentBrush}"
                 Stroke="{StaticResource BgDeepBrush}" StrokeThickness="2"
                 ToolTip="从此拉出连线（此 Agent 依赖别人）"/>
    </Grid>
</UserControl>
