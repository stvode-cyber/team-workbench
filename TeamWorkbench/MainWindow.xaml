<Window x:Class="TeamWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vms="clr-namespace:TeamWorkbench.ViewModels"
        xmlns:views="clr-namespace:TeamWorkbench.Views"
        Title="🤖 AI 专岗员工面板 · v3.0 WPF 原生"
        Height="680" Width="1280"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Style="{StaticResource MainWindowBg}">

    <!-- 合并资源字典（深色主题令牌 + 控件样式）-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ========== 左侧 ListBox ItemTemplate ========== -->
            <DataTemplate x:Key="AgentListItemTemplate" DataType="vms:AgentViewModel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CnName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusLight}" FontSize="16" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>

            <!-- ========== 右侧 ContentTemplate：6 Section 详情 ========== -->
            <DataTemplate x:Key="AgentDetailTemplate" DataType="vms:AgentViewModel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel Margin="20,16">

                        <!-- Section 0: Header（emoji + cn + priority chip）-->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="48" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CnName}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="10,3">
                                        <TextBlock Text="{Binding Priority}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Section 1: 一句话说明 -->
                        <Border Style="{StaticResource SectionHeader}">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="📌 一句话说明"/>
                        </Border>
                        <TextBlock Style="{StaticResource DetailContent}" Text="{Binding Desc}"/>

                        <!-- Section 2: 什么时候调我（手动触发词）-->
                        <Border Style="{StaticResource SectionHeader}" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="🎯 什么时候调我"/>
                        </Border>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,6">手动触发词：</TextBlock>
                        <ItemsControl ItemsSource="{Binding ManualTriggers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="  · " Foreground="{StaticResource AccentBlueBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 用 ListBox 更友好：直接显示每个触发词 -->
                        <ListBox ItemsSource="{Binding ManualTriggers}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Single" IsHitTestVisible="False"
                                 Padding="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Margin" Value="4,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,4">自动触发场景：</TextBlock>
                        <ListBox ItemsSource="{Binding AutoTriggers}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource AccentBlueBrush}" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Single" IsHitTestVisible="False" Padding="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Margin" Value="4,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Section 3: 工作流程 -->
                        <Border Style="{StaticResource SectionHeader}" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="⚙️ 工作流程"/>
                        </Border>
                        <ListBox ItemsSource="{Binding Process}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Single" IsHitTestVisible="False" Padding="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="Margin" Value="2,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▸ " Foreground="{StaticResource AccentBrush}"/>
                                                    <ContentPresenter/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Section 4: 硬性边界 -->
                        <Border Style="{StaticResource SectionHeader}" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="🚫 硬性边界"/>
                        </Border>
                        <ListBox ItemsSource="{Binding Boundary}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource StatusRedBrush}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Single" IsHitTestVisible="False" Padding="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="Margin" Value="2,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⛔ " Foreground="{StaticResource StatusRedBrush}"/>
                                                    <ContentPresenter/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Section 5: 角色定义 -->
                        <Border Style="{StaticResource SectionHeader}" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="📝 角色定义"/>
                        </Border>
                        <TextBlock Style="{StaticResource DetailContent}" Text="{Binding Role}"/>

                        <!-- Section 6: 拥有工具 -->
                        <Border Style="{StaticResource SectionHeader}" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="🛠️ 拥有工具"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgLightBrush}" CornerRadius="4" Padding="8,3" Margin="4,2">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource AccentBlueBrush}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Section 7: 安装操作（Phase 3 新增）-->
                        <Border Style="{StaticResource SectionHeader}" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="📦 安装"/>
                        </Border>
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusLight}" FontSize="20" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding InstallStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ImportBtn"
                                        Content="📥 导入调度" Height="28"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="White" BorderThickness="0"
                                        FontSize="12" FontWeight="Bold"
                                        Cursor="Hand" Padding="12,0" Margin="0,0,8,0"
                                        Click="ImportBtn_Click"/>
                                <Button x:Name="InstallBtn"
                                        Content="📦 安装" Height="28"
                                        Background="{StaticResource AccentBlueBrush}"
                                        Foreground="White" BorderThickness="0"
                                        FontSize="12" FontWeight="Bold"
                                        Cursor="Hand" Padding="12,0"
                                        Click="InstallBtn_Click"/>
                                <Button x:Name="UninstallBtn"
                                        Content="🔧 卸载" Height="28"
                                        Background="{StaticResource BgLightBrush}"
                                        Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0"
                                        FontSize="12" Cursor="Hand" Padding="12,0" Margin="8,0,0,0"
                                        Click="UninstallBtn_Click"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <!-- ========== 主布局：顶栏 + TabControl（4 Tab）════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="36"/>   <!-- Day 12 新增：TabControl 选项卡高度 -->
            <RowDefinition Height="*"/>    <!-- Day 12 调整：Tab 内容区 -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 顶栏（跨两列 · 5 列：标题 + 搜索框 + 筛选 + 状态 + 浮动球按钮）-->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource BgMidBrush}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- 0 标题 -->
                    <ColumnDefinition Width="*"/>        <!-- 1 搜索框 -->
                    <ColumnDefinition Width="110"/>      <!-- 2 筛选 ComboBox -->
                    <ColumnDefinition Width="Auto"/>     <!-- 3 StatusText -->
                    <ColumnDefinition Width="Auto"/>     <!-- 4 OrbToggleBtn 🔵 -->
                    <ColumnDefinition Width="Auto"/>     <!-- 5 CallChainBtn 🔗 -->
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="🤖 AI 专岗员工面板" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text=" · v3.0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,4,0,0"/>
                </StackPanel>

                <!-- 搜索框（绑定 SearchText + PropertyChanged 实时触发 Filter）-->
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBox}"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>

                <!-- 筛选 ComboBox（绑定 StatusFilter + StatusFilterOptions）-->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding StatusFilter}"
                          Style="{StaticResource FilterComboBox}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>

                <!-- StatusText（DB 连接状态）-->
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- 浮动球切换按钮 -->
                <Button x:Name="OrbToggleBtn" Grid.Column="4"
                        Content="🔵" Width="36" Height="32"
                        Background="{StaticResource BgLightBrush}" BorderThickness="0"
                        Foreground="White" FontSize="16"
                        Cursor="Hand" Padding="0" Margin="0"/>

                <!-- 调用链画布按钮（Phase 2 新增）-->
                <Button x:Name="CallChainBtn" Grid.Column="5"
                        Content="🔗 调用链" Height="32"
                        Background="{StaticResource BgLightBrush}" BorderThickness="0"
                        Foreground="White" FontSize="12"
                        Cursor="Hand" Padding="10,0" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- ========== Day 12 新增：48px TabControl ========== -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Grid.ColumnSpan="2"
                    Background="{StaticResource BgMidBrush}"
                    BorderThickness="0"
                    TabStripPlacement="Top">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Header" Value=""/>
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Tab 0: 📋 花名册（完整复用现有布局）-->
            <TabItem Height="32">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="📋 花名册" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：Agent 花名册 ListBox（绑定 FilteredAgents，不再是全量 Agents）-->
                    <ListBox Grid.Column="0"
                             Style="{StaticResource AgentListBox}"
                             ItemsSource="{Binding FilteredAgents}"
                             SelectedItem="{Binding SelectedAgent}"
                             ItemTemplate="{StaticResource AgentListItemTemplate}"/>

                    <!-- GridSplitter -->
                    <GridSplitter Grid.Column="0" Width="3" HorizontalAlignment="Right"
                                  Background="{StaticResource BgLightBrush}"/>

                    <!-- 右侧：详情 ContentControl -->
                    <ContentControl Grid.Column="1"
                                    Content="{Binding SelectedAgent}"
                                    ContentTemplate="{StaticResource AgentDetailTemplate}"/>
                </Grid>
            </TabItem>

            <!-- Tab 1: 🎯 调度中心（Day 13 DispatchCenterView 填三栏 UI）-->
            <TabItem Height="32">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="🎯 调度中心" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <views:DispatchCenterView x:Name="DispatchCenterView"/>
            </TabItem>

            <!-- Tab 2: 📜 日志（Day 14 Python 引擎启动日志 + SSE 心跳）-->
            <TabItem Height="32">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="📜 日志" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <Border Background="{StaticResource BgMidBrush}" Margin="4">
                    <RichTextBox x:Name="Tab2LogOutput"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource BgDeepBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 FontSize="12"/>
                </Border>
            </TabItem>

            <!-- Tab 3: ⚙️ 设置（Day 14 Python 引擎配置骨架）-->
            <TabItem Height="32">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="⚙️ 设置" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <Border Background="{StaticResource BgDeepBrush}" Margin="40">
                    <StackPanel>
                        <TextBlock Text="⚙️ Python 引擎配置" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                        <!-- python.exe 路径 -->
                        <TextBlock Text="Python 可执行文件" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,4,0,6"/>
                        <TextBox x:Name="PythonExeBox" Height="32" Padding="8,0"
                                 Background="{StaticResource BgMidBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="1" BorderBrush="{StaticResource BgLightBrush}"/>

                        <!-- Working Directory -->
                        <TextBlock Text="Python Engine 工作目录" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,16,0,6"/>
                        <TextBox x:Name="PythonWorkingDirBox" Height="32" Padding="8,0"
                                 Background="{StaticResource BgMidBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="1" BorderBrush="{StaticResource BgLightBrush}"/>

                        <!-- 端口 -->
                        <TextBlock Text="端口" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,16,0,6"/>
                        <TextBox x:Name="PythonPortBox" Height="32" Padding="8,0"
                                 IsReadOnly="True"
                                 Background="{StaticResource BgMidBrush}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 BorderThickness="1" BorderBrush="{StaticResource BgLightBrush}"/>

                        <!-- 按钮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                            <Button x:Name="RestartEngineBtn" Content="🔄 重启引擎" Height="36" Padding="20,0"
                                    Background="{StaticResource AccentBlueBrush}"
                                    Foreground="White" BorderThickness="0"
                                    FontSize="13" FontWeight="Bold" Cursor="Hand"
                                    Click="RestartEngineBtn_Click"/>
                            <Button x:Name="SaveSettingsBtn" Content="💾 保存" Height="36" Padding="20,0" Margin="12,0,0,0"
                                    Background="{StaticResource BgLightBrush}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="13" Cursor="Hand"
                                    Click="SaveSettingsBtn_Click"/>
                        </StackPanel>

                        <Border Margin="0,28,0,0" Padding="16,12"
                                Background="{StaticResource BgMidBrush}" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="📦 当前状态" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                <TextBlock Text="⚪ Python 引擎未启动"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="⚪ LiteLLM mock 模式"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ========== Day 12 移到 Tab 0 内部 ========== -->
        <!-- 原 Row 1 的 ListBox + GridSplitter + ContentControl 已在 Tab 0 Content 里 -->
    </Grid>
</Window>
