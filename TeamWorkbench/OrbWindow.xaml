<Window x:Class="TeamWorkbench.OrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="64" Height="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Left="20" Top="200">

    <!-- 圆形背景 + 状态徽章 -->
    <Border x:Name="OrbBorder"
            Width="64" Height="64"
            CornerRadius="32"
            Background="#e94560"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <TextBlock x:Name="StatusText"
                   Text="🟢"
                   FontSize="30"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</Window>
