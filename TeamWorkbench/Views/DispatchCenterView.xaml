<UserControl x:Class="TeamWorkbench.Views.DispatchCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TeamWorkbench.Views"
             xmlns:vms="clr-namespace:TeamWorkbench.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource BgDeepBrush}">

    <!-- 三栏主布局：左 200 默认 + 中 * + 右 350 默认
         两个 GridSplitter 让用户可调栏宽 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="160"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="350" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左栏：Agent 多选 CheckBoxList ========== -->
        <Border Grid.Column="0" Background="{StaticResource BgMidBrush}" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 左栏标题 + Day 18 全选/清空快捷按钮 -->
                <Border Grid.Row="0" Background="{StaticResource BgLightBrush}" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👥 选择专岗" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="✅ 全选" FontSize="11" Padding="8,2" Height="22"
                                    Background="{StaticResource BgMidBrush}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                    Click="SelectAllBtn_Click"/>
                            <Button Content="🗑️ 清空" FontSize="11" Padding="8,2" Height="22"
                                    Background="{StaticResource BgMidBrush}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="ClearAllBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CheckBoxList -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AgentChecklist" Margin="4,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          FontSize="13"
                                          Margin="6,3"
                                          Padding="2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 左-中 Splitter -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                      Background="{StaticResource BgLightBrush}"/>

        <!-- ========== 中栏：模式 + Prompt + 开始按钮 ========== -->
        <Grid Grid.Column="2" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Row 0: 标题+模式 -->
                <RowDefinition Height="Auto"/>   <!-- Row 1: Prompt 标签 -->
                <RowDefinition Height="*"/>      <!-- Row 2: Prompt TextBox -->
                <RowDefinition Height="Auto"/>   <!-- Row 3: 按钮行 -->
            </Grid.RowDefinitions>

            <!-- Row 0: 标题 + 模式下拉 -->
            <Grid Grid.Row="0" Margin="4,6,4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎯 调度中心" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="模式:" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ModeCombo" Width="130" Height="28"
                              VerticalAlignment="Center"
                              Background="{StaticResource BgMidBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderThickness="1" BorderBrush="{StaticResource BgLightBrush}">
                        <ComboBoxItem Content="DIRECT · 单直调"/>
                        <ComboBoxItem Content="SEQUENTIAL · 链式"/>
                        <ComboBoxItem Content="PARALLEL · 并行"/>
                        <ComboBoxItem Content="HYBRID · DAG 拓扑" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Row 1: Prompt 标签 -->
            <TextBlock Grid.Row="1" Text="📝 任务 Prompt"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" Margin="8,4,4,4"/>

            <!-- Row 2: Prompt TextBox -->
            <TextBox x:Name="PromptBox" Grid.Row="2"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource BgMidBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderThickness="1" BorderBrush="{StaticResource BgLightBrush}"
                     Padding="8"
                     FontSize="14"
                     Text="请输入任务描述...（Day 14 接入 Python Scheduler 后，选中的 agent 会按模式执行这个 prompt）"/>

            <!-- Row 3: 按钮行 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,12,0,4">
                <Button x:Name="StopBtn" Content="⏹ 停止" Height="32" Padding="16,0"
                        Background="{StaticResource BgLightBrush}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" FontSize="12" Cursor="Hand" Margin="6,0,0,0"
                        Click="StopBtn_Click"/>
                <Button x:Name="StartBtn" Content="▶ 开始执行" Height="32" Padding="16,0"
                        Background="{StaticResource AccentBlueBrush}"
                        Foreground="White" BorderThickness="0"
                        FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="6,0,0,0"
                        Click="StartBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- 中-右 Splitter -->
        <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Stretch"
                      Background="{StaticResource BgLightBrush}"/>

        <!-- ========== 右栏：SSE 输出 RichTextBox 占位 ========== -->
        <Border Grid.Column="4" Background="{StaticResource BgMidBrush}" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 右栏标题 + 状态指示 -->
                <Border Grid.Row="0" Background="{StaticResource BgLightBrush}" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📜 实时输出" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EngineStatus" Grid.Column="1"
                                   Text="⚪ Python 引擎未启动"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- RichTextBox 占位 -->
                <RichTextBox x:Name="OutputBox" Grid.Row="1"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource BgDeepBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0"
                             FontSize="13"
                             Margin="2"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
